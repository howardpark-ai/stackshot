#!/usr/bin/env python3
"""bin/stackshot: run the package's command line from a checkout without installing it (stdlib only, Python 3.12+). Same as `python3 -m stackshot` in the checkout."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from stackshot.cli import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
